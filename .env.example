# ── Database ───────────────────────────────────────────────────────────────────
# 密碼請換掉，不要留 changeme
POSTGRES_USER=tongue
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tongue

# ── Backend ────────────────────────────────────────────────────────────────────
# 必填，至少 16 個字元，留空或用 changeme 的話 backend 會拒絕啟動。
# 這把密鑰有兩個用途：bot 呼叫 backend 內部端點的共享密鑰、以及後台 LLM API Key 的加密金鑰來源
# （所以換掉它之後，要到後台重新輸入一次 LLM API Key）。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
API_BASE_URL=http://backend:8000

# ── Telegram ───────────────────────────────────────────────────────────────────
# 從 @BotFather 取得
TELEGRAM_BOT_TOKEN=

# ── LINE ───────────────────────────────────────────────────────────────────────
# LINE Developers > Messaging API > Channel secret / Channel access token
# Webhook URL 設為：https://your-domain/webhook/line
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Discord ────────────────────────────────────────────────────────────────────
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=

# ── 選填：限制與保留期（以下是預設值，不需要改就不用取消註解）──────────────────────
# 每位用戶的呼叫頻率上限，0 = 不限制
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=200
# 單次 LLM 呼叫最多等幾秒（本機 Ollama 跑得慢可以調高）
# LLM_TIMEOUT_SECONDS=55
# 資料保留天數，0 = 永久保留。request_logs 預設只留 30 天，對話內容預設永久保留
# LOG_RETENTION_DAYS=30
# MESSAGE_RETENTION_DAYS=0
# 允許跨來源呼叫後台 API 的來源（逗號分隔），只有本機 npm run dev 會用到
# CORS_ORIGINS=http://localhost:5173

# ── 以下由後台設定頁面管理，不需要手動填寫 ─────────────────────────────────────
# llm_provider: ollama | openai | anthropic  (預設 ollama)
# llm_model: llama3 / gpt-4o / claude-sonnet-4-6
# llm_api_key: 後台填寫，加密後存在資料庫，不存在 .env
# llm_base_url: Ollama 的位址（Docker 內預設 http://host.docker.internal:11434）

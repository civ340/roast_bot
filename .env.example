# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=tongue
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tongue

# ── Backend ────────────────────────────────────────────────────────────────────
API_SECRET_KEY=changeme
API_BASE_URL=http://backend:8000

# ── Telegram ───────────────────────────────────────────────────────────────────
# 從 @BotFather 取得
TELEGRAM_BOT_TOKEN=

# ── LINE ───────────────────────────────────────────────────────────────────────
# LINE Developers > Messaging API > Channel secret / Channel access token
# Webhook URL 設為：https://your-domain/webhook/line
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Discord ────────────────────────────────────────────────────────────────────
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=

# ── 以下由後台設定頁面管理，不需要手動填寫 ─────────────────────────────────────
# llm_provider: ollama | openai | anthropic  (預設 ollama)
# llm_model: llama3 / gpt-4o / claude-sonnet-4-6
# llm_api_key: 後台填寫，不存在 .env
# llm_base_url: Ollama 的位址（Docker 內預設 http://host.docker.internal:11434）
